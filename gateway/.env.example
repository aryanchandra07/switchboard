# Copy this file to gateway/.env and fill in real values. gateway/.env is git-ignored.
# Never commit real secrets.

# Signing key for login tokens: at least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SWITCHBOARD_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Master key that encrypts provider API keys: base64 of exactly 32 random bytes.
# Generate one with:  python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Keep a safe copy: if it is lost, stored provider keys must be entered again.
SWITCHBOARD_MASTER_KEY=

# First admin account, created on startup only if no admin exists yet (password: 12+ characters).
SWITCHBOARD_ADMIN_EMAIL=admin@switchboard.local
SWITCHBOARD_ADMIN_PASSWORD=change-me-please

# Database (defaults match infra/docker-compose.yml; uncomment to override)
# SWITCHBOARD_DB_HOST=localhost
# SWITCHBOARD_DB_PORT=5433
# SWITCHBOARD_DB_NAME=switchboard
# SWITCHBOARD_DB_USER=switchboard
# SWITCHBOARD_DB_PASSWORD=switchboard

# Claude (Anthropic) models are OFF by default, so the project costs nothing.
# Set to true only if you have an Anthropic key with a spend limit (store it via PUT /admin/providers/anthropic).
# SWITCHBOARD_ANTHROPIC_ENABLED=false

# Ollama (default http://localhost:11434)
# SWITCHBOARD_OLLAMA_BASE_URL=http://localhost:11434
